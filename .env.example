# Copy to .env (never commit .env)
FLOWDECK_MLLP_PORT=2575
FLOWDECK_HOSPITAL_CONFIG=simulator/hospital.json
# Persist the event store to a file (default: in-memory)
# FLOWDECK_DB=flowdeck.db
# Load the demo hospital on startup (1) or start empty and stream with the simulator (0)
FLOWDECK_DEMO=1
# Optional: use Microsoft Foundry for the ops assistant (keyless auth via DefaultAzureCredential)
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-5-mini
